{
  "name": "loom-backend",
  "version": "0.1.0",
  "description": "LOOM cook-side backend (NestJS + PostgreSQL)",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "typeorm:user": "typeorm-ts-node-commonjs -d src/user-db/data-source.ts",
    "typeorm:admin": "typeorm-ts-node-commonjs -d src/admin-db/data-source.ts",
    "migration:run:user": "npm run typeorm:user -- migration:run",
    "migration:run:admin": "npm run typeorm:admin -- migration:run",
    "migration:run": "npm run migration:run:user && npm run migration:run:admin",
    "migration:revert:user": "npm run typeorm:user -- migration:revert",
    "migration:revert:admin": "npm run typeorm:admin -- migration:revert",
    "db:dev:user": "ts-node scripts/dev-db.ts --name=user",
    "db:dev:admin": "ts-node scripts/dev-db.ts --name=admin",
    "db:test:user": "ts-node scripts/dev-db.ts --name=user --test",
    "db:test:admin": "ts-node scripts/dev-db.ts --name=admin --test",
    "seed:admin": "ts-node scripts/seed-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
