USER_DATABASE_URL=postgres://loom:loom@127.0.0.1:5544/loom_dev
ADMIN_DATABASE_URL=postgres://loom:loom@127.0.0.1:5546/loom_admin_dev
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
PAYOUT_DETAILS_ENCRYPTION_KEY=change-me-32-bytes-minimum-for-aes256
PORT=3000
LOW_STOCK_THRESHOLD_PCT=80
# Online payments (Razorpay) — leave unset to keep the app COD-only; nothing
# breaks when these are absent, see specs/phase-10-razorpay-payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PCT=5
# AI assistant (Google Gemini) — leave unset to fall back to a static "not
# available" reply, see specs/phase-12-ai-assistant.
GEMINI_API_KEY=
# Delivery dispatch (Porter Enterprise API) — leave unset to keep orders
# proceeding without a rider booking (the cook arranges delivery manually);
# see specs/phase-14-delivery-logistics. Requires a Porter Enterprise
# business agreement (porter.in/api-integrations) — no self-serve signup.
PORTER_API_KEY=
PORTER_CLIENT_ID=
PORTER_WEBHOOK_SECRET=
# File uploads (Firebase Storage) — leave both unset to keep writing uploads
# to local disk (backend/uploads/, served at /uploads/<file>), which is what
# local dev and e2e tests use automatically; nothing breaks when these are
# absent. Only needed in the deployed (Render) environment, since Render's
# filesystem is ephemeral. FIREBASE_SERVICE_ACCOUNT_B64 is the full
# service-account JSON key (Firebase console → Project Settings → Service
# accounts → Generate new private key), base64-encoded onto one line, e.g.
# `base64 -i service-account.json | tr -d '\n'`. Copy the bucket name shown
# in the Firebase console exactly — newer projects use a
# `<project>.firebasestorage.app` suffix, not the older `.appspot.com`.
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_B64=
