USER_DATABASE_URL=postgres://loom:loom@127.0.0.1:5544/loom_dev
ADMIN_DATABASE_URL=postgres://loom:loom@127.0.0.1:5546/loom_admin_dev
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
PAYOUT_DETAILS_ENCRYPTION_KEY=change-me-32-bytes-minimum-for-aes256
PORT=3000
LOW_STOCK_THRESHOLD_PCT=80
# Online payments (Razorpay) — leave unset to keep the app COD-only; nothing
# breaks when these are absent, see specs/phase-10-razorpay-payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PCT=5
# AI assistant (Google Gemini) — leave unset to fall back to a static "not
# available" reply, see specs/phase-12-ai-assistant.
GEMINI_API_KEY=
# Delivery dispatch (Porter Enterprise API) — leave unset to keep orders
# proceeding without a rider booking (the cook arranges delivery manually);
# see specs/phase-14-delivery-logistics. Requires a Porter Enterprise
# business agreement (porter.in/api-integrations) — no self-serve signup.
PORTER_API_KEY=
PORTER_CLIENT_ID=
PORTER_WEBHOOK_SECRET=
# File uploads (Supabase Storage) — leave all three unset to keep writing
# uploads to local disk (backend/uploads/, served at /uploads/<file>), which
# is what local dev and e2e tests use automatically; nothing breaks when
# these are absent. Only needed in the deployed (Render) environment, since
# Render's filesystem is ephemeral. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are both under Supabase dashboard → Project Settings → API. The storage
# bucket (name goes in SUPABASE_STORAGE_BUCKET) must be created manually and
# marked "Public" in the dashboard, or uploaded files won't be reachable by
# anyone — a private bucket needs signed URLs instead, which this
# integration doesn't implement. Note: Supabase free projects auto-pause
# after 7 days with no database activity and need manual unpausing from the
# dashboard — worth knowing if the app goes quiet for a while.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
